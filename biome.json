{
	"$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
	"files": {
		"includes": [
			"**/*",
			"!**/node_modules/**",
			"!**/.turbo/**",
			"!**/.claude/**",
			"!**/dist/**",
			"!**/build/**",
			"!**/apps/game-client/**",
			"!**/tsconfig.tsbuildinfo",
			"!**/bun.lock"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": false
	}
}
