<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine. Deliberately UnityEngine-free: it targets netstandard2.1 at
    LangVersion 9 so the exact same source compiles both here (via this csproj)
    and inside Unity 6 (via the com.boardgame.core UPM package + asmdef). Keep
    it free of any dependency Unity cannot resolve.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <RootNamespace>BoardGame.Core</RootNamespace>
    <AssemblyName>BoardGame.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
