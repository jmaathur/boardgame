{
	"name": "boardgame",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --filter=game-server",
		"test": "turbo run test",
		"check-types": "turbo run check-types",
		"catalog:build": "turbo run build --filter=@core/catalog",
		"catalog:check": "turbo run check --filter=@core/catalog",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"flush": "find . \\( -name \"node_modules\" -o -name \".turbo\" -o -name \"dist\" \\) -type d -prune -exec rm -rf {} + && bun i"
	},
	"workspaces": [
		"core/*",
		"apps/*"
	],
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@core/typescript-config": "workspace:*",
		"turbo": "^2.5.3",
		"typescript": "^5.8.2"
	}
}
