# dependencies
node_modules

# build outputs
dist
out
# ...except the built catalog, which is committed so `catalog:check`
# (git diff --exit-code dist) catches drift and the servers can load it.
!core/catalog/dist/
!core/catalog/dist/**

# turbo
.turbo

# dotnet (engine + battle server) — build output only; source is committed
dotnet/artifacts/

# typescript
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# macOS
.DS_Store

# ---------------------------------------------------------------------------
# Unity (apps/game-client) — patterns are unanchored so they apply wherever
# the Unity project lives in the tree.
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files.
# Scoped to the Unity project: the dotnet/ tree's .csproj/.sln ARE committed source.
ExportedObj/
.consulo/
apps/game-client/**/*.csproj
apps/game-client/**/*.sln
*.unityproj
apps/game-client/*.csproj
apps/game-client/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*.json

# Unity builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa
iosBuild/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
