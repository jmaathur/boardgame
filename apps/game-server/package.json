{
	"name": "game-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"dev:match": "bun --watch src/match.ts",
		"start": "bun src/index.ts",
		"start:match": "bun src/match.ts",
		"build": "bun build src/index.ts --compile --outfile dist/game-server && bun build src/match.ts --compile --outfile dist/match-server",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@core/catalog": "workspace:*",
		"@core/types": "workspace:*"
	},
	"devDependencies": {
		"@core/typescript-config": "workspace:*",
		"@types/bun": "^1.2.5",
		"typescript": "^5.8.2"
	}
}
