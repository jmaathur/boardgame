			"inputs": ["$TURBO_ROOT$/dotnet/**", "!$TURBO_ROOT$/dotnet/artifacts/**"],
			"outputs": ["$TURBO_ROOT$/dotnet/artifacts/**"]
		},
		"test": {
			"inputs": ["$TURBO_ROOT$/dotnet/**", "!$TURBO_ROOT$/dotnet/artifacts/**"],
